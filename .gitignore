# Project specific
# static/ is the published site, and the daily pipeline commits into it, so the
# paths it generates are whitelisted back in. Without this, new files (a day's
# archive page, its figures) are silently skipped by `git add static/` and the
# deployed pages end up referencing assets that were never pushed.
static/*
!static/assets/
!static/daily/
!static/figures/
!static/index.html
*.db
*.sqlite3
node_modules/
.cache/

# Daily pipeline scratch/intermediate work (screening batches, extracted
# texts, deep-review drafts) - only the assembled database/daily/*.json|md
# outputs are meant to be committed.
database/daily/work/

paper_collector.log
